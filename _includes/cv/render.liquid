{% comment %}
  LOCAL OVERRIDE of al-folio-cv's templates/cv/render.liquid

  Why this file exists:
  The upstream al-folio-cv plugin always pulls "Experience" (merged with
  "Volunteer") out and renders it immediately after the Summary card,
  before looping over the rest of `cv.sections` — regardless of where
  "Experience" actually appears in _data/cv.yml. That means Education
  (or anything else) can never appear before Experience on the page,
  even if it's listed first in the YAML.

  This override removes that special-casing for the RenderCV branch:
  sections now render in the exact order they appear in cv.sections.
  "Volunteer" entries are still merged into whichever section is named
  "Experience" (same merge behavior as upstream) — it just happens at
  Experience's natural position in the list instead of always first.
  If there's a "Volunteer" key but no "Experience" key, the merged
  block renders at the position of "Volunteer" instead.

  The JSONResume branch is left untouched (copied verbatim from
  upstream) since the reported issue was specific to RenderCV.

  Because Jekyll checks the site's own _includes load path before the
  plugin's, having this file at _includes/cv/render.liquid in your repo
  takes priority over the gem's copy. To go back to upstream behavior,
  just delete this file.
{% endcomment %}

<style>
  /* Profile photo in the Contact Information card */
  .cv-profile-photo {
    display: block;
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    margin: 0.5rem 0 1rem 0;
  }

  /* The al-folio-cv templates use list markup (<ul>/<li>) for entries,
     but this site doesn't load the Bootstrap CSS those classes assume
     (list-group, list-group-item, etc. normally come with
     `list-style: none` baked in). Without that, browsers fall back to
     default bullet markers — the stray black dots. This resets them. */
  .cv ul,
  .cv li {
    list-style: none !important;
    margin: 0;
    padding-left: 0;
  }

  .cv .items {
    padding-left: 1.1rem;
  }

  .cv .items li {
    list-style: disc !important;
  }

  .cv .card {
    overflow: visible;
  }

  .cv .list-group,
  .cv .list-group-item {
    overflow: visible;
  }

  .cv .cv-entry-list {
    display: block;
  }

  .cv .cv-entry-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 0.5rem 0;
  }

  .cv .cv-entry-item:last-child {
    border-bottom: none;
  }

  .cv .list-group-item {
    border-color: rgba(0, 0, 0, 0.08);
  }

  .cv .date-column {
    width: 100px;
    min-width: 100px;
    max-width: 100px;
    padding-right: 0.6rem;
    padding-left: 0;
    flex: 0 0 100px;
  }

  .cv .table-cv {
    width: 100%;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    overflow: visible;
  }

  .cv .table-cv td {
    padding: 0;
    border: 0;
    vertical-align: top;
  }

  .cv .table-cv .badge {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 0.2rem 0.3rem;
    font-size: 0.72rem;
    line-height: 1.15;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
    box-shadow: none !important;
    text-shadow: none !important;
    filter: none !important;
  }

  .cv .table-cv .location {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.25rem;
    margin: 0.3rem 0 0;
    line-height: 1.1;
    text-align: center;
    white-space: normal;
    word-break: break-word;
    font-size: 0.78rem;
  }

  .cv .table-cv .iconlocation {
    display: inline-block;
    flex: 0 0 auto;
    line-height: 1;
    margin-top: 0.15rem;
    font-size: 0.78rem;
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% comment %} Determine which CV format to render {% endcomment %}
      {% assign render_rendercv = false %}
      {% assign render_jsonresume = false %}

      {% if page.cv_format == 'rendercv' %}
        {% assign render_rendercv = true %}
      {% elsif page.cv_format == 'jsonresume' %}
        {% assign render_jsonresume = true %}
      {% else %}
        {% comment %} Legacy behavior: RenderCV takes priority if both exist {% endcomment %}
        {% if site.data.cv and site.data.cv.cv %}
          {% assign render_rendercv = true %}
        {% elsif site.data.resume %}
          {% assign render_jsonresume = true %}
        {% endif %}
      {% endif %}

      {% if render_rendercv and site.data.cv and site.data.cv.cv %}
        {% comment %} RenderCV format {% endcomment %}
        {% assign cv = site.data.cv.cv %}

        <!-- Header/Contact Information -->
        {% if cv.name or cv.label or cv.location or cv.email or cv.phone or cv.website or cv.image %}
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Contact Information</h3>
            {% if cv.image %}
              <img
                class="cv-profile-photo"
                src="{{ cv.image | relative_url }}"
                alt="{{ cv.name | default: 'Profile photo' }}"
              />
            {% endif %}
            <table class="table table-cv table-sm table-borderless">
              {% if cv.name %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Name</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td>
                </tr>
              {% endif %}
              {% if cv.label %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Professional Title</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td>
                </tr>
              {% endif %}
              {% if cv.email %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Email</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ cv.email }}</td>
                </tr>
              {% endif %}
              {% if cv.phone %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Phone</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ cv.phone }}</td>
                </tr>
              {% endif %}
              {% if cv.address %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>
                  <td class="p-1 pl-2 font-weight-light">
                    {% if cv.address.street %}{{ cv.address.street }}, {% endif %}
                    {% if cv.address.city %}{{ cv.address.city }}, {% endif %}
                    {% if cv.address.region %}{{ cv.address.region }} {% endif %}
                    {% if cv.address.postalCode %}{{ cv.address.postalCode }}{% endif %}
                  </td>
                </tr>
              {% endif %}
              {% if cv.website %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Website</b></td>
                  <td class="p-1 pl-2 font-weight-light">
                    <a href="{{ cv.website }}" target="_blank">{{ cv.website }}</a>
                  </td>
                </tr>
              {% endif %}
            </table>
          </div>
        {% endif %}

        <!-- Summary -->
        {% if cv.summary %}
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Professional Summary</h3>
            <p>{{ cv.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          </div>
        {% endif %}

        {% comment %}
          Render every section exactly where it appears in cv.sections.
          No merging, no special-casing of Experience/Volunteer — each
          gets its own card, in YAML order. Sections that share the same
          underlying field shape as a recognized type reuse that type's
          sub-template (e.g. Teaching/Volunteer look just like Experience
          entries; Presentations look like Publications entries; Trainings
          look like Certificates entries) so nothing falls into the blank
          generic fallback.
        {% endcomment %}
        {% for section_pair in cv.sections %}
          {% assign section_title = section_pair[0] %}
          {% assign section_entries = section_pair[1] %}

          <a class="anchor" id="{{ section_title | slugify }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
            <div>
              {% if section_title == 'Education' %}
                {% assign entries = section_entries %}
                {% include cv/education.liquid %}
              {% elsif section_title == 'Experience' or section_title == 'Volunteer' or section_title == 'Teaching' %}
                {% comment %} company/position/start_date/end_date/location/summary/highlights — same shape as Experience {% endcomment %}
                {% assign entries = section_entries %}
                {% include cv/experience.liquid %}
              {% elsif section_title == 'Awards' or section_title == 'Honors and Awards' %}
                {% assign entries = section_entries %}
                {% include cv/awards.liquid %}
              {% elsif section_title == 'Publications' or section_title == 'Presentations' %}
                {% comment %} title/summary/date(or releaseDate) — same shape as Publications {% endcomment %}
                {% assign entries = section_entries %}
                {% include cv/publications.liquid %}
              {% elsif section_title == 'Skills' %}
                <ul class="card-text font-weight-light list-group list-group-flush">
                  {% for entry in section_entries %}
                    <li class="list-group-item py-2">
                      <div class="d-flex align-items-start">
                        {% if entry.icon %}
                          <i
                            class="fa-solid {{ entry.icon }} fa-fw flex-shrink-0 mt-1 me-2"
                            style="width: 1rem; text-align: center;"
                            aria-hidden="true"
                          ></i>
                        {% endif %}
                        <div class="flex-grow-1">
                          {% if entry.name %}<strong>{{ entry.name }}</strong>{% endif %}
                          {% if entry.keywords %}
                            <div class="font-weight-light">{{ entry.keywords }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              {% elsif section_title == 'Languages' %}
                {% assign entries = section_entries %}
                {% include cv/languages.liquid %}
              {% elsif section_title == 'Interests' or section_title == 'Academic Interests' %}
                {% assign entries = section_entries %}
                {% include cv/interests.liquid %}
              {% elsif section_title == 'Certificates' or section_title == 'Trainings' %}
                {% comment %} name/issuer/date(optional) — same shape as Certificates {% endcomment %}
                {% assign entries = section_entries %}
                {% include cv/certificates.liquid %}
              {% elsif section_title == 'Projects' or section_title == 'Open Source Projects' %}
                {% assign entries = section_entries %}
                {% include cv/projects.liquid %}
              {% elsif section_title == 'References' %}
                {% assign entries = section_entries %}
                {% include cv/references.liquid %}
              {% elsif section_title == 'Memberships' %}
                <ul class="card-text font-weight-light list-group list-group-flush">
                  {% for entry in section_entries %}
                    <li class="list-group-item py-2">
                      <div class="d-flex align-items-start">
                        {% if entry.icon %}
                          <i
                            class="fa-solid {{ entry.icon }} fa-fw flex-shrink-0 mt-1 me-2"
                            style="width: 1rem; text-align: center;"
                            aria-hidden="true"
                          ></i>
                        {% endif %}
                        <div class="flex-grow-1 d-flex justify-content-between align-items-start gap-2">
                          <strong>{{ entry.name }}</strong>
                          {% assign start_date = entry.start_date | default: '' %}
                          {% assign end_date = entry.end_date | default: '' %}
                          {% assign start_year = start_date | split: '-' | first | strip %}
                          {% assign end_year = end_date | split: '-' | first | strip %}
                          {% if start_date != '' and end_date != '' and start_year != '' and end_year != '' and start_year == end_year and end_year != 'Present' %}
                            <span class="text-muted small">{{ start_year }}</span>
                          {% elsif start_date != '' %}
                            <span class="text-muted small">{{ start_year }} - {{ end_year | default: 'Present' }}</span>
                          {% endif %}
                        </div>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <!-- Generic section: bullet/label entries only -->
                {% for entry in section_entries %}
                  {% if entry.bullet %}
                    <ul class="card-text font-weight-light list-group list-group-flush">
                      <li class="list-group-item">{{ entry.bullet | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                    </ul>
                  {% elsif entry.label %}
                    <div class="card-text font-weight-light">
                      <strong>{{ entry.label }}:</strong> {{ entry.details }}
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endfor %}

      {% elsif render_jsonresume and site.data.resume %}
        {% comment %} JSONResume format — unchanged from upstream {% endcomment %}

        <!-- Contact Information -->
        {% if site.data.resume.basics %}
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Contact Information</h3>
            {% assign basics = site.data.resume.basics %}
            <table class="table table-cv table-sm table-borderless">
              {% if basics.name %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Name</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ basics.name }}</td>
                </tr>
              {% endif %}
              {% if basics.label %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Professional Title</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ basics.label }}</td>
                </tr>
              {% endif %}
              {% if basics.email %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Email</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ basics.email }}</td>
                </tr>
              {% endif %}
              {% if basics.phone %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Phone</b></td>
                  <td class="p-1 pl-2 font-weight-light">{{ basics.phone }}</td>
                </tr>
              {% endif %}
              {% if basics.location %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>
                  <td class="p-1 pl-2 font-weight-light">
                    {% if basics.location.address %}{{ basics.location.address }}, {% endif %}
                    {% if basics.location.city %}{{ basics.location.city }}, {% endif %}
                    {% if basics.location.region %}{{ basics.location.region }} {% endif %}
                    {% if basics.location.postalCode %}{{ basics.location.postalCode }}{% endif %}
                  </td>
                </tr>
              {% endif %}
              {% if basics.url %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>Website</b></td>
                  <td class="p-1 pl-2 font-weight-light">
                    <a href="{{ basics.url }}" target="_blank">{{ basics.url }}</a>
                  </td>
                </tr>
              {% endif %}
            </table>
          </div>
        {% endif %}

        <!-- Summary -->
        {% if site.data.resume.basics.summary %}
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Professional Summary</h3>
            <p>{{ site.data.resume.basics.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          </div>
        {% endif %}

        <!-- JSONResume Sections - Merge work and volunteer into Experience -->
        {% assign empty_array = '' | split: ',' %}
        {% assign work = site.data.resume.work | default: empty_array %}
        {% assign vol = site.data.resume.volunteer | default: empty_array %}
        {% assign combined_experience = work | concat: vol %}
        {% if combined_experience.size > 0 %}
          <a class="anchor" id="experience"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Experience</h3>
            <div>
              {% assign entries = combined_experience %}
              {% include cv/experience.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Education -->
        {% if site.data.resume.education.size > 0 %}
          <a class="anchor" id="education"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Education</h3>
            <div>
              {% assign entries = site.data.resume.education %}
              {% include cv/education.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Awards -->
        {% if site.data.resume.awards.size > 0 %}
          <a class="anchor" id="awards"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Awards</h3>
            <div>
              {% assign entries = site.data.resume.awards %}
              {% include cv/awards.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Publications -->
        {% if site.data.resume.publications.size > 0 %}
          <a class="anchor" id="publications"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Publications</h3>
            <div>
              {% assign entries = site.data.resume.publications %}
              {% include cv/publications.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Skills -->
        {% if site.data.resume.skills.size > 0 %}
          <a class="anchor" id="skills"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Skills</h3>
            <div>
              {% assign entries = site.data.resume.skills %}
              {% include cv/skills.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Languages -->
        {% if site.data.resume.languages.size > 0 %}
          <a class="anchor" id="languages"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Languages</h3>
            <div>
              {% assign entries = site.data.resume.languages %}
              {% include cv/languages.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Interests -->
        {% if site.data.resume.interests.size > 0 %}
          <a class="anchor" id="interests"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Interests</h3>
            <div>
              {% assign entries = site.data.resume.interests %}
              {% include cv/interests.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Certificates -->
        {% if site.data.resume.certificates.size > 0 %}
          <a class="anchor" id="certificates"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Certificates</h3>
            <div>
              {% assign entries = site.data.resume.certificates %}
              {% include cv/certificates.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- Projects -->
        {% if site.data.resume.projects.size > 0 %}
          <a class="anchor" id="projects"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Projects</h3>
            <div>
              {% assign entries = site.data.resume.projects %}
              {% include cv/projects.liquid %}
            </div>
          </div>
        {% endif %}

        <!-- References -->
        {% if site.data.resume.references.size > 0 %}
          <a class="anchor" id="references"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">References</h3>
            <div>
              {% assign entries = site.data.resume.references %}
              {% include cv/references.liquid %}
            </div>
          </div>
        {% endif %}

      {% else %}
        <p>No CV data found. Please configure either RenderCV (cv.yml) or JSONResume (resume.json) data.</p>
      {% endif %}
    </div>
  </article>
</div>
